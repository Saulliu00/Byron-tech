---
import type { Product } from '@/data/products';

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<article class="card-base group border border-gray-100">
  <!-- Image placeholder -->
  <div class="h-40 bg-gradient-to-br from-primary-50 to-primary-100 flex items-center justify-center">
    <div class="text-5xl opacity-60">⚙️</div>
  </div>

  <div class="p-5">
    <span class="text-xs font-medium bg-gray-100 text-gray-600 px-2 py-1 rounded-full">
      {product.category}
    </span>
    <h3 class="text-base font-bold text-gray-900 mt-2 mb-1 group-hover:text-primary-700 transition-colors">
      {product.name}
    </h3>
    <p class="text-sm text-gray-600 mb-3 leading-relaxed">{product.description}</p>

    <ul class="space-y-1">
      {
        product.specs.map((spec) => (
          <li class="text-xs text-gray-500 flex items-center gap-1.5">
            <span class="w-1 h-1 bg-primary-400 rounded-full shrink-0"></span>
            {spec}
          </li>
        ))
      }
    </ul>

    <div class="mt-4 pt-4 border-t border-gray-100">
      <a
        href="/contact"
        class="text-sm font-medium text-primary-700 hover:text-primary-800 flex items-center gap-1 transition-colors"
      >
        询价 / 咨询
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</article>
