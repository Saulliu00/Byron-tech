---
import { company } from '@/data/company';
import { navItems } from '@/data/navigation';
---

<footer class="bg-primary-900 text-gray-300">
  <div class="container-max mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">

      <!-- Brand -->
      <div class="lg:col-span-2">
        <div class="mb-4">
          <img src="/logo.png" alt="Byron Intelligence" class="h-[88px] w-auto object-contain brightness-0 invert" />
        </div>
        <p class="text-sm leading-relaxed text-gray-400 max-w-sm">
          {company.description}
        </p>
        <div class="mt-6 flex flex-col gap-2 text-sm">
          <a href={`tel:${company.phone}`} class="flex items-center gap-2 hover:text-white transition-colors">
            <svg class="w-4 h-4 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            {company.phone}
          </a>
          <a href={`mailto:${company.email}`} class="flex items-center gap-2 hover:text-white transition-colors">
            <svg class="w-4 h-4 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            {company.email}
          </a>
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            {company.address}
          </span>
        </div>
      </div>

      <!-- Navigation -->
      <div>
        <h3 class="text-white font-semibold mb-4">快速导航</h3>
        <ul class="space-y-2 text-sm">
          {navItems.map((item) => (
            <li>
              <a href={item.href} class="hover:text-white transition-colors">{item.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Services -->
      <div>
        <h3 class="text-white font-semibold mb-4">业务领域</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/services/automation-parts" class="hover:text-white transition-colors">工业智能化集成解决方案</a></li>
          <li><a href="/services/vision-solutions" class="hover:text-white transition-colors">视觉产线解决方案</a></li>
          <li><a href="/services/ai-solutions" class="hover:text-white transition-colors">AI 知识数字化</a></li>
          <li><a href="/products" class="hover:text-white transition-colors">产品中心</a></li>
          <li><a href="/contact" class="hover:text-white transition-colors">联系我们</a></li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-primary-800">
    <div class="container-max mx-auto px-4 sm:px-6 lg:px-8 py-5 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-gray-500">
      <p>© {new Date().getFullYear()} {company.name}. 保留所有权利。</p>
      {company.icp && <p><a href="https://beian.miit.gov.cn" target="_blank" rel="noopener noreferrer" class="hover:text-gray-300 transition-colors">{company.icp}</a></p>}
    </div>
  </div>
</footer>
