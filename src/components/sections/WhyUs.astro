---
import SectionHeader from '@/components/ui/SectionHeader.astro';

const reasons = [
  {
    icon: '🏭',
    title: '深厚行业积累',
    description: '超过 10 年服务制造业客户的经验，深刻理解工厂实际需求与落地挑战。',
  },
  {
    icon: '🔧',
    title: '硬件 + 软件一体化',
    description: '从精密零部件选型到视觉系统集成，再到 AI 模型开发，提供一站式解决方案。',
  },
  {
    icon: '🤝',
    title: '全程服务保障',
    description: '项目立项、方案设计、部署实施到售后维护，全程驻场支持。',
  },
  {
    icon: '📊',
    title: '数据驱动决策',
    description: '以数据为核心，将隐性工艺知识转化为可量化、可复制的数字资产。',
  },
  {
    icon: '⚡',
    title: '快速响应交付',
    description: '标准零部件 72 小时发货，定制方案 7 个工作日内出具技术方案。',
  },
  {
    icon: '🔒',
    title: '质量认证保障',
    description: '所有产品均通过严格质量检验，关键部件提供完整溯源文件。',
  },
];
---

<section class="section-padding bg-white">
  <div class="container-max mx-auto">
    <SectionHeader
      eyebrow="为什么选择我们"
      title="专注专业，值得信赖"
      subtitle="拜伦智能科技致力于以专业技术和优质服务，帮助每一家合作企业实现智能化转型。"
      center
    />

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        reasons.map((reason) => (
          <div class="p-6 rounded-2xl border border-gray-100 hover:border-primary-200 hover:shadow-md transition-all duration-300 group">
            <div class="text-3xl mb-3">{reason.icon}</div>
            <h3 class="text-base font-bold text-gray-900 mb-2 group-hover:text-primary-700 transition-colors">
              {reason.title}
            </h3>
            <p class="text-sm text-gray-600 leading-relaxed">{reason.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
