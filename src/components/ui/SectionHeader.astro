---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  center?: boolean;
}

const { eyebrow, title, subtitle, center = false } = Astro.props;
---

<div class:list={['mb-12', center ? 'text-center' : '']}>
  {
    eyebrow && (
      <span class="text-sm font-semibold text-primary-600 uppercase tracking-widest mb-3 block">
        {eyebrow}
      </span>
    )
  }
  <h2 class="section-title">{title}</h2>
  {subtitle && <p class:list={['section-subtitle', center ? 'mx-auto' : '']}>{subtitle}</p>}
</div>
