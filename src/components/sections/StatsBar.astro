---
import { stats } from '@/data/company';
---

<section class="bg-primary-700 py-14">
  <div class="container-max mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 text-center">
      {
        stats.map((stat) => (
          <div>
            <p class="text-4xl font-bold text-white mb-1">{stat.value}</p>
            <p class="text-sm text-primary-200">{stat.label}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
