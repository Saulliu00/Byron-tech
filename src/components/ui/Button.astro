---
interface Props {
  href?: string;
  variant?: 'primary' | 'outline' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  target?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  class: className = '',
  target,
} = Astro.props;

const sizeClasses = {
  sm: 'px-4 py-2 text-sm',
  md: 'px-6 py-3 text-base',
  lg: 'px-8 py-4 text-lg',
};

const variantClasses = {
  primary: 'bg-primary-700 text-white hover:bg-primary-800',
  outline: 'border-2 border-primary-700 text-primary-700 hover:bg-primary-700 hover:text-white',
  ghost: 'text-primary-700 hover:bg-primary-50',
};

const classes = `inline-flex items-center justify-center gap-2 font-medium rounded-lg transition-colors duration-200 ${sizeClasses[size]} ${variantClasses[variant]} ${className}`;
---

{
  href ? (
    <a href={href} class={classes} target={target}>
      <slot />
    </a>
  ) : (
    <button class={classes}>
      <slot />
    </button>
  )
}
