---
import Button from '@/components/ui/Button.astro';
import { company } from '@/data/company';
---

<section class="relative min-h-[90vh] flex items-center overflow-hidden bg-gradient-to-br from-primary-900 via-primary-800 to-primary-700">
  <!-- Background grid pattern -->
  <div class="absolute inset-0 opacity-10"
    style="background-image: linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 60px 60px;">
  </div>

  <!-- Decorative circles -->
  <div class="absolute top-1/4 right-0 w-96 h-96 bg-accent-400/10 rounded-full blur-3xl"></div>
  <div class="absolute bottom-0 left-1/4 w-80 h-80 bg-primary-500/20 rounded-full blur-3xl"></div>

  <div class="container-max mx-auto px-4 sm:px-6 lg:px-8 py-24 relative z-10">
    <div class="max-w-3xl">
      <!-- Eyebrow -->
      <div class="inline-flex items-center gap-2 bg-white/10 border border-white/20 rounded-full px-4 py-1.5 mb-8">
        <span class="w-2 h-2 bg-accent-400 rounded-full animate-pulse"></span>
        <span class="text-sm text-white/80 font-medium">{company.name}</span>
      </div>

      <!-- Headline -->
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white leading-tight mb-6">
        智能制造<br />
        <span class="text-accent-400">驱动未来</span>
      </h1>

      <!-- Description -->
      <p class="text-lg text-primary-100 leading-relaxed mb-10 max-w-2xl">
        从精密自动化零部件到基于视觉的智能产线，再到将企业经验转化为数字资产的 AI 解决方案 ——
        我们为中国制造业提供全链路智能升级服务。
      </p>

      <!-- CTA Buttons -->
      <div class="flex flex-wrap gap-4">
        <Button href="/services" variant="primary" size="lg">
          探索业务领域
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </Button>
        <Button href="/contact" variant="outline" size="lg"
          class="border-white/40 text-white hover:bg-white hover:text-primary-800">
          联系我们
        </Button>
      </div>

      <!-- Quick stats -->
      <div class="mt-16 flex flex-wrap gap-8">
        <div>
          <p class="text-3xl font-bold text-accent-400">10+</p>
          <p class="text-sm text-primary-200 mt-0.5">年行业经验</p>
        </div>
        <div class="w-px bg-white/20 hidden sm:block"></div>
        <div>
          <p class="text-3xl font-bold text-accent-400">200+</p>
          <p class="text-sm text-primary-200 mt-0.5">合作企业</p>
        </div>
        <div class="w-px bg-white/20 hidden sm:block"></div>
        <div>
          <p class="text-3xl font-bold text-accent-400">50+</p>
          <p class="text-sm text-primary-200 mt-0.5">落地项目</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1 text-white/50">
    <span class="text-xs">向下滚动</span>
    <svg class="w-5 h-5 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </div>
</section>
