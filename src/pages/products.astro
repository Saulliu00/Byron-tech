---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProductCard from '@/components/ui/ProductCard.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import CtaBanner from '@/components/sections/CtaBanner.astro';
import { products, productCategories } from '@/data/products';
---

<BaseLayout
  title="产品中心"
  description="浙江拜伦智能科技工业智能化解决方案产品目录，包括转台、导轨、电机及运动控制器。"
>
  <!-- Hero -->
  <section class="bg-gradient-to-br from-primary-900 to-primary-700 py-20">
    <div class="container-max mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="text-sm font-semibold text-accent-400 uppercase tracking-widest mb-4 block">产品中心</span>
      <h1 class="text-4xl sm:text-5xl font-bold text-white mb-4">工业智能化解决方案产品目录</h1>
      <p class="text-primary-200 max-w-xl mx-auto">
        精选高精度运动控制与传动组件，满足各类自动化设备需求。
      </p>
    </div>
  </section>

  <!-- Product Grid -->
  <section class="section-padding bg-white">
    <div class="container-max mx-auto">
      <!-- Category Filter (static display) -->
      <div class="flex flex-wrap gap-2 mb-10">
        {productCategories.map((cat) => (
          <span class="px-4 py-1.5 text-sm font-medium bg-primary-50 text-primary-700 rounded-full border border-primary-100 cursor-default">
            {cat}
          </span>
        ))}
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {products.map((product) => <ProductCard product={product} />)}
      </div>

      <!-- Inquiry note -->
      <div class="mt-12 p-6 bg-gray-50 rounded-2xl border border-gray-200 text-center">
        <p class="text-gray-600 text-sm mb-3">
          未找到所需型号？我们支持按需定制和特殊规格采购。
        </p>
        <a href="/contact" class="btn-primary text-sm py-2 px-5">
          联系技术顾问
        </a>
      </div>
    </div>
  </section>

  <CtaBanner title="需要特殊规格或定制方案？" subtitle="我们的工程师团队将为您提供专业选型建议。" />
</BaseLayout>
