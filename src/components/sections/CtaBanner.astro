---
import Button from '@/components/ui/Button.astro';

interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = '准备好开始您的智能化升级了吗？',
  subtitle = '联系我们的技术顾问，获取专属解决方案与报价。',
} = Astro.props;
---

<section class="bg-gradient-to-r from-primary-800 to-primary-700 py-16">
  <div class="container-max mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-2xl sm:text-3xl font-bold text-white mb-3">{title}</h2>
    <p class="text-primary-200 mb-8 max-w-xl mx-auto">{subtitle}</p>
    <div class="flex flex-wrap gap-4 justify-center">
      <Button href="/contact" size="lg"
        class="bg-accent-400 text-primary-900 hover:bg-accent-500 border-0">
        立即咨询
      </Button>
      <Button href="/services" variant="outline" size="lg"
        class="border-white/40 text-white hover:bg-white hover:text-primary-800">
        查看服务方案
      </Button>
    </div>
  </div>
</section>
