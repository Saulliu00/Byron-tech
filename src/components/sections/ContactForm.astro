---
import { company } from '@/data/company';
---

<section class="section-padding bg-white">
  <div class="container-max mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">

      <!-- Info -->
      <div>
        <span class="text-sm font-semibold text-primary-600 uppercase tracking-widest mb-3 block">联系我们</span>
        <h2 class="section-title">期待与您合作</h2>
        <p class="text-gray-600 leading-relaxed mb-8">
          无论您有零部件采购需求、视觉系统项目，还是希望了解 AI 数字化转型方案，
          我们的技术顾问将在 24 小时内与您取得联系。
        </p>

        <ul class="space-y-5">
          <li class="flex items-start gap-4">
            <div class="w-10 h-10 bg-primary-50 rounded-xl flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div>
              <p class="text-sm font-medium text-gray-500">电话</p>
              <a href={`tel:${company.phone}`} class="text-gray-900 font-medium hover:text-primary-700 transition-colors">
                {company.phone}
              </a>
            </div>
          </li>
          <li class="flex items-start gap-4">
            <div class="w-10 h-10 bg-primary-50 rounded-xl flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <p class="text-sm font-medium text-gray-500">邮箱</p>
              <a href={`mailto:${company.email}`} class="text-gray-900 font-medium hover:text-primary-700 transition-colors">
                {company.email}
              </a>
            </div>
          </li>
          <li class="flex items-start gap-4">
            <div class="w-10 h-10 bg-primary-50 rounded-xl flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <p class="text-sm font-medium text-gray-500">地址</p>
              <p class="text-gray-900 font-medium">{company.address}</p>
            </div>
          </li>
        </ul>
      </div>

      <!-- Form -->
      <div class="card-base border border-gray-100 p-8">
        <form
          name="contact"
          method="POST"
          data-netlify="true"
          class="space-y-5"
        >
          <input type="hidden" name="form-name" value="contact" />

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1.5" for="name">姓名 *</label>
              <input
                id="name"
                name="name"
                type="text"
                required
                placeholder="您的姓名"
                class="w-full px-4 py-3 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition"
              />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1.5" for="company">公司名称</label>
              <input
                id="company"
                name="company"
                type="text"
                placeholder="所在公司"
                class="w-full px-4 py-3 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition"
              />
            </div>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5" for="email">邮箱 *</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              placeholder="your@email.com"
              class="w-full px-4 py-3 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition"
            />
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5" for="interest">感兴趣的业务</label>
            <select
              id="interest"
              name="interest"
              class="w-full px-4 py-3 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition bg-white"
            >
              <option value="">请选择</option>
              <option value="automation-parts">自动化零部件</option>
              <option value="vision-solutions">视觉产线解决方案</option>
              <option value="ai-solutions">AI 知识数字化</option>
              <option value="other">其他</option>
            </select>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5" for="message">留言 *</label>
            <textarea
              id="message"
              name="message"
              required
              rows="4"
              placeholder="请描述您的需求或问题…"
              class="w-full px-4 py-3 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition resize-none"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full btn-primary justify-center py-3.5 text-base"
          >
            发送消息
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
            </svg>
          </button>
        </form>
      </div>
    </div>
  </div>
</section>
